[Unit]
Description=Boekhouding (self-hosted bookkeeping server)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=boekhouding
Group=boekhouding
WorkingDirectory=/opt/boekhouding/server
ExecStart=/opt/boekhouding/server/target/release/boekhouding serve
Restart=always
RestartSec=2
EnvironmentFile=/opt/boekhouding/server/.env
MemoryMax=512M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/boekhouding/server/data

[Install]
WantedBy=multi-user.target
