[Unit]
Description=Boekhouding (Not Bad Company bookkeeping server)
# Listens on the Pi's Tailscale address only (BOEK_BIND), so it waits for it.
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=daanhpi
Group=daanhpi
WorkingDirectory=/home/daanhpi/projects/work/boekhouding/server
ExecStart=/home/daanhpi/projects/work/boekhouding/server/target/release/boekhouding serve
Restart=always
RestartSec=2
# BOEK_SECRET, BOEK_DATA, BOEK_IBAN, BREVO_API_KEY, EMAIL_FROM_*: server/.env.
EnvironmentFile=/home/daanhpi/projects/work/boekhouding/server/.env
# The company's public details (NBC_*), shared with every Not Bad Company site.
EnvironmentFile=-/home/daanhpi/projects/work/.env
MemoryMax=512M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/daanhpi/projects/work/boekhouding/server/data

[Install]
WantedBy=multi-user.target
