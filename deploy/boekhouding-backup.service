[Unit]
Description=Boekhouding backup (database snapshot and attachments)
After=network-online.target

[Service]
Type=oneshot
# Same user and paths as boekhouding.service; BOEK_BACKUP_DIR must be writable by it.
User=boekhouding
Group=boekhouding
WorkingDirectory=/opt/boekhouding
EnvironmentFile=/opt/boekhouding/server/.env
ExecStart=/opt/boekhouding/scripts/backup.sh
Nice=10
IOSchedulingClass=idle
