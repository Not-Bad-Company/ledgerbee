<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS everywhere, except the server's Tailscale address: that link is
     already WireGuard-encrypted and has no public name for a certificate. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">100.66.214.122</domain>
        <domain includeSubdomains="false">daanhpi</domain>
        <!-- Debugging over adb reverse. -->
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
