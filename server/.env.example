# Copy to server/.env (never commit it). The company's name, KvK, btw-id and
# address are NOT here: they come from the shared ~/projects/work/.env (NBC_*).

# 32+ random characters: `openssl rand -hex 32`. Seals the TOTP secret; if it
# changes, run `boekhouding create-user` again.
BOEK_SECRET=
BOEK_DATA=/home/daanhpi/projects/work/boekhouding/server/data
# The Pi's Tailscale address: reachable from the phone and laptop on the
# tailnet, never from the internet.
BOEK_BIND=100.66.214.122:8090
# Printed on invoices. Kept out of the shared public .env on purpose.
BOEK_IBAN=
# Where reminders go (defaults to NBC_EMAIL).
BOEK_OWNER_EMAIL=

# E-mail through Brevo, the same account as Krentenweger.
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=administratie@notbadcompany.com
EMAIL_FROM_NAME=Not Bad Company

# Backups (scripts/backup.sh): a local folder, and optionally an rclone remote
# for the off-site copy. The bewaarplicht is seven years.
BOEK_BACKUP_DIR=/home/daanhpi/backups/boekhouding
BOEK_BACKUP_REMOTE=
