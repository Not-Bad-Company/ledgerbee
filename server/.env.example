# Copy to server/.env and fill in. Never commit the real file.
# Company details (name, KvK, btw-id, address, IBAN) are entered in the app
# under Instellingen → Onderneming; BOEK_COMPANY_* variables here are only a
# fallback for fields the app leaves empty.

# 32+ random characters: `openssl rand -hex 32`. Seals the TOTP secret; if it
# changes, run `boekhouding create-user` again.
BOEK_SECRET=
BOEK_DATA=/opt/boekhouding/server/data
# Where the API listens. Keep it off the open internet: 127.0.0.1 behind a
# reverse proxy or tunnel with https, or your Tailscale address (100.x.y.z).
BOEK_BIND=127.0.0.1:8090
# Where the daily reminders go (defaults to the company e-mail).
BOEK_OWNER_EMAIL=

# Optional: reminder e-mails and sending invoices go through Brevo's HTTP
# API (free tier is plenty). The sender must be verified in Brevo.
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=

# Backups (scripts/backup.sh): a local folder, and optionally an rclone remote
# for the off-site copy. The bewaarplicht is seven years.
BOEK_BACKUP_DIR=/var/backups/boekhouding
BOEK_BACKUP_REMOTE=
